{
  "name": "toanthuluat",
  "version": "2.1.0",
  "description": "Toan thu luat phap 2.1 - static global law full-text encyclopedia",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "sync": "node server/jobs/sync-all.js",
    "import": "node server/jobs/import-cli.js",
    "import:manual": "node server/jobs/import-manual.js --file data/manual-content.json",
    "import:ecfr": "node server/jobs/import-cli.js --source ecfr --limit 200",
    "import:govinfo": "node server/jobs/import-cli.js --source govinfo --limit 500",
    "import:all": "node server/jobs/import-cli.js --all --limit 100",
    "import:status": "node server/jobs/import-cli.js --status",
    "db:migrate": "node server/db/migrate.js",
    "build:data": "node scripts/build-static.js && node scripts/prepare-github-pages.js",
    "build:pages": "node scripts/prepare-github-pages.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "sql.js": "^1.10.2",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "redis": "^4.6.10"
  }
}
