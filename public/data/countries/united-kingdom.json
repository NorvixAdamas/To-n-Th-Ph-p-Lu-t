 "cases": [
  {
   "id": 34,
   "name": "Pepper v Hart [1992] UKHL 3 – Hansard",
   "sourceId": "uk-case-3",
   "court": "House of Lords",
   "docket": "[1993] AC 593",
   "dateDecided": "1992-11-26",
   "year": 1992,
   "kind": "judgment",
   "kindLabel": "Bản án",
   "fields": [
    "other"
   ],
   "fieldLabels": [
    "Lĩnh vực khác"
   ],
   "summary": "House of Lords permitted reference to Hansard (parliamentary debates) when interpreting ambiguous legislation. Overturned prior exclusionary rule. Courts may look at ministerial statements on the purpose of legislation. Significant impact on UK statutory interpretation methodology.",
   "sourceUrl": "https://www.bailii.org/uk/cases/UKHL/1992/3.html"
  },
  {
   "id": 33,
   "name": "R v R [1991] UKHL 12 – Marital Rape",
   "sourceId": "uk-case-2",
   "court": "House of Lords",
   "docket": "[1992] 1 AC 599",
   "dateDecided": "1991-10-23",
   "year": 1991,
   "kind": "judgment",
   "kindLabel": "Bản án",
   "fields": [
    "criminal"
   ],
   "fieldLabels": [
    "Luật hình sự"
   ],
   "summary": "House of Lords abolished marital rape exemption. The fiction of implied consent had no useful purpose. Husband can be convicted of raping his wife. Major step in gender equality and criminal law. Later codified in Sexual Offences Act 2003.",
   "sourceUrl": "https://www.bailii.org/uk/cases/UKHL/1991/12.html"
  },
  {
   "id": 32,
   "name": "Donoghue v Stevenson [1932] AC 562 (Neighbour Principle)",
   "sourceId": "uk-case-1",
   "court": "House of Lords",
   "docket": "[1932] AC 562",
   "dateDecided": "1932-05-26",
   "year": 1932,
   "kind": "judgment",
   "kindLabel": "Bản án",
   "fields": [
    "civil"
   ],
   "fieldLabels": [
    "Luật dân sự"
   ],
   "summary": "Landmark UK negligence case. Mrs Donoghue drank ginger beer containing decomposed snail. Lord Atkin established Neighbour Principle: you must take reasonable care to avoid acts or omissions which you can reasonably foresee would injure your neighbour. Foundation of modern tort of negligence in common law. Adopted acros",
   "sourceUrl": "https://www.bailii.org/uk/cases/UKHL/1932/100.html"
  }
 ],
