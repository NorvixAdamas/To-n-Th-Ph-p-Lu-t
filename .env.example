# Server
PORT=3000

# Force lightweight local mode with SQLite only
# SQLITE_ONLY=1

# PostgreSQL (Docker: postgres:5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/toanthuluat

# Redis (optional, for job queue)
REDIS_URL=redis://localhost:6379

# Congress.gov API - free key at https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# OpenLaws - register at https://openlaws.us/api/
OPENLAWS_API_KEY=

# CourtListener - free token at https://www.courtlistener.com/api/rest-info/
COURTLISTENER_TOKEN=

# Run daily sync at 02:00 (Asia/Ho_Chi_Minh)
# ENABLE_CRON=1
